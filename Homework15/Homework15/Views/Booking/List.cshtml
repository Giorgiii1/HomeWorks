@model List<Homework15.Models.Appointment>

@{
    ViewData["Title"] = "Appointments List";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Active Appointments (JSON DB)</h2>
        <a asp-action="Index" class="btn btn-success">New Appointment</a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">No appointments found.</div>
    }
    else
    {
        <table class="table table-striped table-hover shadow-sm rounded">
            <thead class="table-dark">
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Doctor</th>
                <th>Time</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var app in Model)
            {
                <tr>
                    <td>@app.FirstName</td>
                    <td>@app.LastName</td>
                    <td><span class="badge bg-secondary">@app.Doctor</span></td>
                    <td><strong>@app.Time</strong></td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>