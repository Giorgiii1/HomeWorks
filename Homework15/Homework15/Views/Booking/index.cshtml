@model Homework15.Models.Appointment

@{
    ViewData["Title"] = "Doctor Booking";
}

<div class="container mt-5" style="max-width: 500px;">
    <h2 class="text-center mb-4">Book a Doctor's Appointment</h2>
    
    <form asp-action="Index" method="post" class="shadow p-4 rounded bg-light">
        <div class="mb-3">
            <label class="form-label">First Name</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Last Name</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Doctor</label>
            <select asp-for="Doctor" class="form-select">
                <option value="">-- Select Doctor --</option>
                <option value="Dentist">Dentist</option>
                <option value="Cardiologist">Cardiologist</option>
                <option value="Pediatrician">Pediatrician</option>
            </select>
            <span asp-validation-for="Doctor" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Appointment Time (10:00 - 19:00)</label>
            <input asp-for="Time" type="time" class="form-control" />
            <span asp-validation-for="Time" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Book Appointment</button>
    </form>
</div>